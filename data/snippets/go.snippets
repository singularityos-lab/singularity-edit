<?xml version="1.0" encoding="UTF-8"?>
<snippets _group="Go">
  <snippet _name="Function" trigger="func" _description="Function">
    <text languages="go"><![CDATA[func ${1:name}(${2}) ${3:error} {
	$0
}]]></text>
  </snippet>
  <snippet _name="Error check" trigger="iferr" _description="Return on error">
    <text languages="go"><![CDATA[if err != nil {
	return ${1:err}
}]]></text>
  </snippet>
  <snippet _name="Test" trigger="test" _description="Test function">
    <text languages="go"><![CDATA[func Test${1:Name}(t *testing.T) {
	$0
}]]></text>
  </snippet>
</snippets>
